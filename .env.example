# --- Core ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database / Redis ---
DATABASE_URL=postgresql://clawhub:clawhub@localhost:5432/clawhub
REDIS_URL=redis://localhost:6379

# --- Auth ---
# In production JWT_SECRET MUST be set and >= 32 chars; CLAWHUB_SECRETS_KEY must
# be a 32-byte base64 key. The API refuses to start otherwise.
JWT_SECRET=change-me-in-production
CLAWHUB_SECRETS_KEY=

# --- Git storage ---
GIT_REPOS_BASE_PATH=./data/repos

# --- Standing agents (BYO 24/7 agents; docs/standing-agents.md) ---
# All optional — sane defaults shown.
# Per-agent dispatch rate cap per 10-minute window (bounds any loop shape).
CLAWHUB_STANDING_RATE_CAP=30
# How long a standing-agent run may run before the stale-run reaper fails it.
# Much longer than CI runs (15m) since an agent loop legitimately runs long.
CLAWHUB_STANDING_RUNNING_TIMEOUT_MS=7200000
# Circuit breaker: auto-pause an agent after this many consecutive failed runs.
CLAWHUB_STANDING_MAX_FAILURES=5
# At-least-once delivery: re-publish a pending+unclaimed standing run after this.
CLAWHUB_STANDING_REPUBLISH_AFTER_MS=120000
# --- Agent memory (FIT; docs/memory.md) ---
# Per-run cap on memories an agent may write, and the dispatch memory-pack budget.
CLAWHUB_MEMORY_WRITES_PER_RUN=50
CLAWHUB_MEMORY_PACK_TOKENS=1500

# Run-dispatch events (ci.run.queued) carry a per-run token that unlocks run
# secrets, so they are NEVER streamed to user tokens. By default any agent token
# may receive them (so the operator runner works with no config). For multi-tenant
# isolation, set this to your runner agents' ids (comma-separated) and run
# per-tenant runners — then run dispatch is scoped to allowlisted/collaborator agents.
CLAWHUB_RUNNER_AGENT_IDS=

# --- Public URL (used for OG images, webhook origins, SAML metadata, etc.) ---
CLAWHUB_PUBLIC_URL=http://localhost:3000

# --- Self-hosting / edge (docs/self-host.md) ---
# Domain for the Caddy proxy profile: <domain> → dashboard, api.<domain> → API.
CLAWHUB_DOMAIN=
CLAWHUB_ACME_EMAIL=
# Edge profile for the Caddy container. Default uses ACME (public certs);
# set to ./deploy/caddy/Caddyfile.cloudflare when Cloudflare proxies the
# domain and terminates public TLS (SSL mode "Full").
CLAWHUB_CADDYFILE=./deploy/caddy/Caddyfile
# When set, Redis requires AUTH even inside the compose network (recommended
# in production; limits lateral movement). Leave empty for dev.
REDIS_PASSWORD=
POSTGRES_PASSWORD=
# Per-IP per-minute limits. Git pushes are ~3 requests each.
CLAWHUB_API_RATE_LIMIT=100
CLAWHUB_GIT_RATE_LIMIT=240

# --- Dashboard ---
DASHBOARD_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_GITHUB_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- OAuth sign-in (routes/oauth.ts) ---
# Configure either or both; the login page shows buttons for configured ones.
# Callback URLs to register with the provider:
#   <CLAWHUB_PUBLIC_URL>/api/v1/oauth/github/callback
#   <CLAWHUB_PUBLIC_URL>/api/v1/oauth/google/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Where to send the browser after sign-in (defaults to http://localhost:3001).
CLAWHUB_DASHBOARD_URL=

# --- Admin console (routes/admin.ts) ---
# Comma-separated list of user emails granted /api/v1/admin/* access.
CLAWHUB_ADMIN_EMAILS=

# --- GraphQL (routes/graphql.ts) ---
# Disabled by default: the resolver layer is not yet per-caller authz-scoped, so
# an open /api/v1/graphql would let any valid token read across tenants. Leave
# unset until the resolvers are scoped. Set to "true" only if you understand this.
CLAWHUB_GRAPHQL_ENABLED=

# --- SCIM (routes/scim.ts) ---
CLAWHUB_SCIM_TOKEN=

# --- Mailer (services/mailer.ts) ---
# Pick one: log | resend | smtp. `log` writes outbox to stdout; safe default.
CLAWHUB_MAILER=log
CLAWHUB_EMAIL_FROM=ClawHub <noreply@useclawhub.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_STARTTLS=0

# --- Object store / S3 (services/object-store.ts) ---
# local | s3
CLAWHUB_OBJECT_STORE=local
S3_BUCKET=
S3_ENDPOINT=
S3_PUBLIC_BASE=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- KMS (services/kms.ts) ---
# Set AWS_KMS_KEY_ID to use AwsKmsProvider; otherwise LocalKeyProvider is used.
AWS_KMS_KEY_ID=

# --- Chatops (routes/chatops.ts) ---
CLAWHUB_SLACK_SIGNING_SECRET=
CLAWHUB_DISCORD_PUBLIC_KEY=

# --- CRM (services/crm.ts) ---
SLACK_LEAD_WEBHOOK=
HUBSPOT_API_KEY=

# --- Billing (services/stripe.ts + services/platform-billing.ts, M7) ---
STRIPE_WEBHOOK_SECRET=
# With these unset the reporter still stamps SKUs but pushes nothing to Stripe.
STRIPE_SECRET_KEY=
# Stripe Price IDs (M7 live checkout). STRIPE_PRICE_PRO = the $20/seat Pro
# subscription price; the two metered prices attach to the same subscription so
# review-overage + verify meter events bill. Empty ⇒ checkout is disabled.
STRIPE_PRICE_PRO=
STRIPE_PRICE_REVIEW_OVERAGE=
STRIPE_PRICE_VERIFY=
# Platform-billing reporter interval (ms). Default 5 min.
CLAWHUB_BILLING_REPORT_MS=300000

# --- Observability ---
# Optional Sentry DSN — when set, errors are reported via envelope API.
SENTRY_DSN=

# --- Runner (services/sandbox.ts, packages/runner) ---
# Set to 1 to run sandboxed CI steps inside Docker (requires /var/run/docker.sock).
CLAWHUB_DOCKER=0
CLAWHUB_RUNNER_WORKDIR=/tmp/clawhub-runner
# Max concurrent runs per runner (bounds sandboxed-CI container fan-out). Default 4.
CLAWHUB_RUNNER_MAX_CONCURRENT=4

# --- Capability-graded CI execution (multi-tenant safety) ---
# By default CI pipeline steps run CONTAINED (a per-run sandbox: no host access, no runner
# token) so another repo's CI can't touch the host / kill prod. HOST execution (deploy +
# image-build pipelines that need docker/systemd/the live checkout) is granted ONLY to
# repos in this OPERATOR-ONLY allowlist (comma-separated <ns>/<repo> or repo id) AND only
# when their pipeline declares `execution: host`. Set it to your self-deploy + build repos;
# leave EMPTY on a multi-tenant runner so nobody gets host. Read only in the API process —
# a tenant cannot self-grant. See docs/operations.md → "Capability-graded CI execution".
CLAWHUB_CI_HOST_EXEC_REPOS=
# ── Platform-LLM metering gateway (M3) ──────────────────────────────────────
# The real platform model key. Read ONLY in the API process; injected into
# upstream Anthropic calls and NEVER handed to a container (which gets a per-run
# gateway token instead). Empty ⇒ the gateway 503s and platform-keyed features
# (native review, verify) are off. Only ClawHub-owned system agents may use it.
CLAWHUB_PLATFORM_ANTHROPIC_KEY=
# Optional overrides: upstream base, per-model prices (JSON, USD/MTok), gateway
# rate bucket (req/min/IP — a streaming reviewer makes many; also exempt
# /api/v1/llm/* at the Cloudflare edge). Anthropic API version override too.
CLAWHUB_ANTHROPIC_UPSTREAM=https://api.anthropic.com
CLAWHUB_PLATFORM_MODEL_PRICES=
CLAWHUB_LLM_RATE_LIMIT=6000
# ── Open-model routing via OpenRouter (D8) ──────────────────────────────────
# Point the platform reviewer/verify at open models instead of Anthropic. Set
# CLAWHUB_PLATFORM_PROVIDER=openrouter and supply an OpenRouter key here (read
# ONLY in the API process — like the Anthropic key it NEVER enters a container).
# The gateway FORCES US-host pinning per the qualified catalog, so a container
# can only reach a named US host, never a PRC first-party API.
CLAWHUB_PLATFORM_PROVIDER=anthropic
CLAWHUB_PLATFORM_OPENAI_KEY=
CLAWHUB_PLATFORM_OPENAI_BASE_URL=https://openrouter.ai/api/v1
# The open-model slug pinned to each capability tier (D9). fast = cheap review;
# balanced = the verify workhorse; frontier = 5% audits + sensitive review. Defaults
# are live + harness-safe (qwen3-coder / GLM-4.6 on DeepInfra) — NOT DeepSeek, whose
# thinking-mode tool-call loop 400s a codex harness. Swap in the benched D9 lineup
# (GLM-5.2 / DeepSeek V4) via env once those slugs go live. Must appear in the catalog.
CLAWHUB_PLATFORM_MODEL_FAST=qwen/qwen3-coder
CLAWHUB_PLATFORM_MODEL_BALANCED=z-ai/glm-5.2
CLAWHUB_PLATFORM_MODEL_FRONTIER=z-ai/glm-5.2
# Qualified (model → host, US provider slugs, quantization, fallback price) catalog
# as JSON. Overrides/extends the built-in defaults; an entry with no providerOnly
# is ignored (routing is never left un-pinned). Example:
#   {"deepseek/deepseek-chat-v3.1":{"host":"DeepInfra (US)","providerOnly":["deepinfra"],"quantizations":["fp8"],"price":{"input":0.21,"output":0.79}}}
CLAWHUB_PLATFORM_OPENAI_CATALOG=
# ── D10 spend caps & abuse controls ─────────────────────────────────────────
# GLOBAL hard ceiling (whole USD) on ALL platform-key spend across every tenant,
# checked at dispatch + the gateway. Sits UNDER the OpenRouter/Anthropic prepaid
# wall as a server-side stop so no traffic spike can drain the balance. Default $100.
CLAWHUB_PLATFORM_GLOBAL_MONTHLY_CAP=100
# Per-request input-token ceiling at the gateway (giant-diff blowout guard). Default 50k.
CLAWHUB_PLATFORM_MAX_INPUT_TOKENS=50000
# The conservative default monthly budget ($) auto-created for a tenant the instant a
# Loop / origin='agent' dispatch draws a platform key (never unlimited; onExhaust=block).
CLAWHUB_LOOP_BUDGET_DEFAULT_USD=50
# Platform-keyed VERIFY (D10). Metered $2 e2e run — OFF by default. Master flag; a repo
# still opts in per-repo (platformVerifyEnabled). Paid plans only; free = 0 verify.
CLAWHUB_PLATFORM_VERIFY_ENABLED=
# Kill switch for the M1 deterministic focus-floor synthesis (=1 disables it).
CLAWHUB_DISABLE_FOCUS_SYNTHESIS=
# A standing run that FAILS within this window (ms) of the API process booting is
# treated as a deploy-abort, not a real fault — it won't push the agent toward
# its circuit breaker (M4 infra-abort tagging). Default 120s.
CLAWHUB_INFRA_ABORT_WINDOW_MS=120000
# ── Runner capacity + placement (M6, set on the RUNNER host) ─────────────────
# Cap heavy DinD (--privileged) verify runs separately from the global cap so one
# node isn't swamped. Optional node tagging lets a lean node LEAVE heavy verify
# runs (app/services/dind) for a beefier node (the atomic claim = the other node
# picks them up). Unset ⇒ any runner takes anything (today's behavior).
CLAWHUB_RUNNER_MAX_CONCURRENT_DIND=1
CLAWHUB_RUNNER_NODE_TYPE=
CLAWHUB_RUNNER_HEAVY_TIER_NODE=
# Server-pinned image sandboxed CI steps run in (a repo cannot choose it). Default node:20.
CLAWHUB_CI_DEFAULT_IMAGE=node:20
# Server-pinned image for `execution: build` runs (CONTAINED rootless image build, no host
# docker). Default rootless BuildKit. Needs host user-namespaces enabled (kernel go/no-go:
# `unshare -Ur echo ok`). Allowlisted repos only — the deploy/build capability, never tenants.
CLAWHUB_CI_BUILD_IMAGE=moby/buildkit:rootless

# --- MCP / CLI consumers (packages/mcp, packages/cli) ---
CLAWHUB_API_URL=http://localhost:3000
CLAWHUB_URL=http://localhost:3000
CLAWHUB_TOKEN=
