# Git
GIT_REPOS_BASE_PATH=./data/repos

# Server
PORT=3000
NODE_ENV=development

# Dashboard
DASHBOARD_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000

# ClawHub skill
CLAWHUB_API_URL=http://localhost:3000
