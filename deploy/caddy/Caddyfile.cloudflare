# ClawHub edge — Cloudflare-proxied profile. Cloudflare terminates public
# TLS (SSL mode "Full"); the origin serves a self-signed internal cert, so
# no ACME account or email is needed here.
#
#   {$CLAWHUB_DOMAIN}      → dashboard
#   api.{$CLAWHUB_DOMAIN}  → API + git Smart HTTP

{$CLAWHUB_DOMAIN} {
	tls internal
	encode gzip
	reverse_proxy dashboard:3000
}

api.{$CLAWHUB_DOMAIN} {
	tls internal

	# Prometheus metrics are for the internal network only — they enumerate
	# routes, repo names, and traffic patterns. Scrape from inside the
	# compose network (http://api:3000/metrics), never through the edge.
	@metrics path /metrics
	respond @metrics 403

	# Compress REST JSON before the (cross-continent) hop to Cloudflare — the
	# origin↔edge leg isn't compressed by CF. Scoped to /api/* so it never
	# buffers or breaks git Smart HTTP packfile streaming (#2).
	@api path /api/*
	encode @api gzip

	# Git pushes stream packfiles; don't buffer or cap them at the edge.
	request_body {
		max_size 512MB
	}
	reverse_proxy api:3000 {
		flush_interval -1
	}
}
