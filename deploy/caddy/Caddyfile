# ClawHub edge. Caddy provisions and renews Let's Encrypt certificates
# automatically — the only requirements are DNS records pointing here and
# ports 80/443 reachable.
#
#   {$CLAWHUB_DOMAIN}      → dashboard
#   api.{$CLAWHUB_DOMAIN}  → API + git Smart HTTP

# To register an ACME account email, add a global block:
#   { email you@example.com }
# (An `email {$VAR}` line with the variable unset is a fatal parse error,
# so the default config omits it.)

{$CLAWHUB_DOMAIN} {
	encode gzip
	reverse_proxy dashboard:3000
}

api.{$CLAWHUB_DOMAIN} {
	# Prometheus metrics are for the internal network only — they enumerate
	# routes, repo names, and traffic patterns. Scrape from inside the
	# compose network (http://api:3000/metrics), never through the edge.
	@metrics path /metrics
	respond @metrics 403

	# Git pushes stream packfiles; don't buffer or cap them at the edge.
	request_body {
		max_size 512MB
	}
	reverse_proxy api:3000 {
		flush_interval -1
		# Strip CLIENT-supplied IP headers so only Caddy's own X-Forwarded-For is
		# trusted; set CLAWHUB_TRUSTED_PROXY_COUNT=1 in the API to honour it. Without
		# that env the API ignores these headers and keys per-IP limits by socket
		# peer, so a spoofed header can't mint a fresh rate-limit bucket (#159).
		header_up -Cf-Connecting-Ip
		header_up -X-Real-Ip
	}
}
