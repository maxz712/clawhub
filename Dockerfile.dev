FROM node:20-slim

WORKDIR /app

# Install git — needed for simple-git and git-http-backend
RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*

# Copy workspace root files
COPY package.json package-lock.json* ./
COPY tsconfig.base.json ./

# Copy all package manifests (needed for npm workspaces)
COPY packages/api/package.json packages/api/
COPY packages/dashboard/package.json packages/dashboard/
COPY packages/openclaw-skill/package.json packages/openclaw-skill/
COPY packages/cli/package.json packages/cli/

# Install all dependencies (including devDependencies for tsx watch)
RUN npm install --ignore-scripts

# Copy API source (will be overridden by volume mount for src/)
COPY packages/api/ packages/api/

# Create data directory for git repos
RUN mkdir -p /data/repos

EXPOSE 3000

# Run dev server with hot reload via tsx watch
CMD ["npm", "-w", "@clawforge/api", "run", "dev"]
